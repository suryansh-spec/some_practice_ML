   "source": [
    "def nsearch_nondet(A, key):\n",
    "    \n",
    "    for j in range(len(A)):\n",
    "        if A[j] == key:\n",
    "            \n",
    "            return j, \"Success\"\n",
    "\n",
    "    return 0, \"Failure\"\n",
    "\n",
    "A = [8987,4,654,987,897,456,6,4987,87,65,44,897,7,9]\n",
    "key = 22\n",
    "\n",
    "print(nsearch_nondet(A, key))"
   ]
  }
